{
  "name": "lcdsmao-blog",
  "private": true,
  "description": "lcdsmao blog",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,astro,svelte,css}\"",
    "dev": "astro dev",
    "build:wasm": "sh -c 'command -v wasm-pack >/dev/null 2>&1 && wasm-pack build wasm/hello --target web --out-dir ../../public/wasm/hello || echo \"wasm-pack not found, using prebuilt wasm\"'",
    "build": "npm run build:wasm && astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.5",
    "astro": "^5.18.0",
    "svelte": "^5.53.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
