---
import "../styles/global.css"
import InteractiveBackground from "../components/InteractiveBackground.svelte"
import DarkToggle from "../components/DarkToggle.svelte"

const { title = "lcdsmao" } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600&family=Outfit:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script>
      (() => {
        try {
          const saved = localStorage.getItem("theme")
          if (saved) document.documentElement.dataset.theme = saved
        } catch (err) {
          document.documentElement.dataset.theme = "light"
        }
      })()
    </script>
  </head>
  <body>
    <InteractiveBackground client:load />
    <div class="top-right">
      <DarkToggle client:load />
    </div>
    <slot />
  </body>
</html>
