---
import BaseLayout from "../layouts/BaseLayout.astro"
import GitHubLink from "../components/GitHubLink.svelte"
---
<BaseLayout title="lcdsmao">
  <main class="page">
    <section class="card">
      <a href="/hello" aria-label="Open hello page">
        <img
          class="avatar"
          src="https://github.com/lcdsmao.png"
          alt="lcdsmao avatar"
          loading="lazy"
        />
      </a>
      <div class="links">
        <GitHubLink client:load />
      </div>
    </section>
  </main>
</BaseLayout>
